rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidUser(data) {
      return data.keys().hasAll(['level', 'speed', 'totalSpeed', 'trophies', 'totalTrophies', 'raceStage', 'wallIndex', 'ownedItems', 'rebirths', 'lastSaveTime'])
        && (!('nickname' in data) || (data.nickname is string && data.nickname.size() <= 50))
        && (!('profilePic' in data) || (data.profilePic is string && data.profilePic.size() <= 2048))
        && data.level is number
        && data.speed is number
        && data.totalSpeed is number
        && data.trophies is number
        && data.totalTrophies is number
        && data.raceStage is number
        && data.wallIndex is number
        && (!('equippedTrail' in data) || (data.equippedTrail is string && data.equippedTrail.size() <= 100))
        && (!('equippedAura' in data) || (data.equippedAura is string && data.equippedAura.size() <= 100))
        && data.ownedItems is list && data.ownedItems.size() <= 200
        && (data.ownedItems.size() == 0 || data.ownedItems[0] is string)
        && data.rebirths is number
        && data.lastSaveTime is number
        && (!('createdAt' in data) || data.createdAt is timestamp || data.createdAt is number)
        && (!('updatedAt' in data) || data.updatedAt is timestamp || data.updatedAt is number)
        && (!('world' in data) || data.world is number)
        && (!('cashMultiplier' in data) || data.cashMultiplier is number)
        && (!('doubleTrophies' in data) || data.doubleTrophies is bool)
        && (!('fpsLimit' in data) || data.fpsLimit is number)
        && (!('trophyMulti' in data) || data.trophyMulti is number)
        && (!('keyboardSound' in data) || data.keyboardSound is number)
        && (!('naro' in data) || data.naro is number)
        && (!('doubleSpeed' in data) || data.doubleSpeed is bool)
        && (!('friends' in data) || data.friends is list)
        && (!('gardenMoney' in data) || data.gardenMoney is number)
        && (!('gardenInventory' in data) || data.gardenInventory is map)
        && (!('gardenPlots' in data) || data.gardenPlots is list)
        && (!('gardenCrops' in data) || data.gardenCrops is map)
        && (!('gardenShopEpoch' in data) || data.gardenShopEpoch is number)
        && (!('gardenShopStock' in data) || data.gardenShopStock is map)
        && (!('gardenVersion' in data) || data.gardenVersion is string || data.gardenVersion == null)
        && (!('gardenEggs' in data) || data.gardenEggs is list)
        && (!('gardenPets' in data) || data.gardenPets is list)
        && (!('gardenEquippedPets' in data) || data.gardenEquippedPets is list)
        && (!('badges' in data) || data.badges is list)
        && (!('towerStage' in data) || data.towerStage is number)
        && (!('lotteryTickets' in data) || data.lotteryTickets is number)
        && (!('lotteryBuffs' in data) || data.lotteryBuffs is map)
        && (!('hardcoreDead' in data) || data.hardcoreDead is bool)
        && (!('settings' in data) || data.settings is map)
        && (!('fishingState' in data) || data.fishingState is map)
        && (!('gardenTools' in data) || data.gardenTools is map)
        && (!('gardenToolLevels' in data) || data.gardenToolLevels is map)
        && (!('eatCoins' in data) || data.eatCoins is number)
        && (!('age' in data) || data.age is number || data.age is string)
        && (!('description' in data) || (data.description is string && data.description.size() <= 500))
        && (!('survivor' in data) || data.survivor is map)
        && (!('survivorStage' in data) || data.survivorStage is number);
    }
    
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // For leaderboards
      
      allow create: if isSignedIn() 
                    && isValidId(userId) 
                    && (request.auth.uid == userId || request.auth.token.email == 'leeseok981@gmail.com')
                    && isValidUser(incoming());

      allow update: if isSignedIn() 
                    && (request.auth.uid == userId || request.auth.token.email == 'leeseok981@gmail.com' || incoming().diff(existing()).affectedKeys().hasOnly(['friends', 'updatedAt']))
                    && isValidUser(incoming())
                    && (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt)
                    && (!('updatedAt' in incoming()) || incoming().updatedAt == request.time || incoming().updatedAt is number || incoming().updatedAt is timestamp)
                    && incoming().diff(existing()).affectedKeys().hasOnly(['nickname', 'profilePic', 'level', 'speed', 'totalSpeed', 'trophies', 'totalTrophies', 'raceStage', 'wallIndex', 'equippedTrail', 'equippedAura', 'ownedItems', 'rebirths', 'lastSaveTime', 'createdAt', 'updatedAt', 'world', 'cashMultiplier', 'doubleTrophies', 'fpsLimit', 'trophyMulti', 'keyboardSound', 'naro', 'doubleSpeed', 'friends', 'gardenMoney', 'gardenInventory', 'gardenPlots', 'gardenCrops', 'gardenShopEpoch', 'gardenShopStock', 'gardenVersion', 'gardenEggs', 'gardenPets', 'gardenEquippedPets', 'badges', 'towerStage', 'lotteryTickets', 'lotteryBuffs', 'hardcoreDead', 'settings', 'fishingState', 'gardenTools', 'gardenToolLevels', 'eatCoins', 'age', 'description', 'survivor', 'survivorStage']);

      allow delete: if isSignedIn() && request.auth.token.email == 'leeseok981@gmail.com';
    }

    
    function isValidPost(data) {
      return data.keys().hasAll(['authorId', 'authorName', 'authorPic', 'type', 'url', 'text', 'likes', 'comments', 'createdAt'])
        && data.authorId is string && data.authorId.size() <= 128
        && data.authorName is string && data.authorName.size() <= 100
        && data.authorPic is string && data.authorPic.size() <= 200
        && data.type is string && data.type.size() <= 10
        && data.url is string && data.url.size() <= 1048576
        && data.text is string && data.text.size() <= 10000
        && data.likes is list && data.likes.size() <= 10000
        && data.comments is list && data.comments.size() <= 1000
        && data.createdAt is timestamp;
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() 
                    && isValidPost(incoming())
                    && incoming().authorId == request.auth.uid
                    && incoming().createdAt == request.time;
      allow update: if isSignedIn()
                    && isValidPost(incoming())
                    && incoming().authorId == existing().authorId
                    && incoming().createdAt == existing().createdAt
                    && incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'comments']);
      allow delete: if isSignedIn() && existing().authorId == request.auth.uid;
    }
    
    
    
    
    function isValidBlog(data) {
      return data.keys().hasAll(['title', 'content', 'authorId', 'authorName', 'likesCount', 'createdAt'])
        && data.title is string && data.title.size() <= 200
        && data.content is string && data.content.size() <= 30000
        && data.authorId is string && data.authorId.size() <= 128
        && data.authorName is string && data.authorName.size() <= 100
        && data.likesCount is number
        && data.createdAt is timestamp;
    }
    match /blogs/{blogId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && isValidBlog(incoming())
                    && incoming().authorId == request.auth.uid
                    && incoming().createdAt == request.time;
      allow update: if isSignedIn()
                    && isValidBlog(incoming())
                    && incoming().authorId == existing().authorId
                    && incoming().createdAt == existing().createdAt
                    && incoming().diff(existing()).affectedKeys().hasOnly(['likesCount']);
      allow delete: if isSignedIn() && existing().authorId == request.auth.uid;
    }

match /friendRequests/{reqId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().from == request.auth.uid;
      allow update: if isSignedIn() && existing().to == request.auth.uid && incoming().status == 'accepted';
      allow delete: if isSignedIn() && (existing().from == request.auth.uid || existing().to == request.auth.uid);
    }
    
    match /{collection}/{docId} {
      allow read: if collection.matches('^events_.*');
      allow write: if isSignedIn() && collection.matches('^events_.*');
    }

    match /channels/{channelId}/messages/{msgId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /channels/{channelId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /events/{eventId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.token.email == 'leeseok981@gmail.com' || docId == 'adminEvents');
    }
    match /gardenEvents/{eventId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.token.email == 'leeseok981@gmail.com';
    }
    
    match /naroCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.token.email == 'leeseok981@gmail.com';
      allow update: if isSignedIn() && existing().used == false && incoming().used == true;
    }

    
    match /customGames/{gameId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.token.email == 'leeseok981@gmail.com');
      allow delete: if isSignedIn() && (request.auth.token.email == 'leeseok981@gmail.com' || resource.data.creatorUid == request.auth.uid);
    }

    match /system/{docId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.token.email == 'leeseok981@gmail.com';
    }
  }
}
